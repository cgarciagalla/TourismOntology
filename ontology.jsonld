}, {
  "@id" : "http://www.semanticweb.org/cggallardo/ontologies/2025/3/TourismOntology",
  "@type" : [ "http://www.w3.org/2002/07/owl#Ontology" ],
  "http://purl.org/dc/terms/description" : [ {
    "@value" : "This ontology models tourism-related information, including cities, attractions, restaurants, hotels, transport systems, and events. It allows semantic representation and reasoning over various entities in the tourism domain. The ontology supports classification of instances, spatial relationships (e.g., location in city), and quality assessments (e.g., ratings, cost levels). It has been developed following the LOT methodology and includes SWRL rules and links to external resources like DBpedia."
  } ],
  "http://purl.org/dc/terms/issued" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "20-04-2025"
  } ],
  "http://purl.org/dc/terms/modified" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "30-04-2025"
  } ],
  "http://purl.org/dc/terms/publisher" : [ {
    "@value" : "Carlos García Gallardo"
  } ],
  "http://purl.org/dc/terms/title" : [ {
    "@value" : "Tourism Ontology"
  } ],
  "http://www.w3.org/2002/07/owl#versionInfo" : [ {
    "@value" : "v1.0.0.0"
  } ]
}, {
