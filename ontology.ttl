@prefix : <http://www.semanticweb.org/cggallardo/ontologies/2025/3/TourismOntology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/cggallardo/ontologies/2025/3/TourismOntology#> .

<http://www.semanticweb.org/cggallardo/ontologies/2025/3/TourismOntology> rdf:type owl:Ontology ;
                                                                           <http://purl.org/dc/terms/description> "This ontology models tourism-related information, including cities, attractions, restaurants, hotels, transport systems, and events. It allows semantic representation and reasoning over various entities in the tourism domain. The ontology supports classification of instances, spatial relationships (e.g., location in city), and quality assessments (e.g., ratings, cost levels). It has been developed following the LOT methodology and includes SWRL rules and links to external resources like DBpedia." ;
                                                                           <http://purl.org/dc/terms/issued> "20-04-2025"^^xsd:date ;
                                                                           <http://purl.org/dc/terms/modified> "30-04-2025"^^xsd:date ;
                                                                           <http://purl.org/dc/terms/publisher> "Carlos García Gallardo" ;
                                                                           <http://purl.org/dc/terms/title> "Tourism Ontology" ;
                                                                           owl:versionInfo "v1.0.0.0" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/description
<http://purl.org/dc/terms/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/issued
<http://purl.org/dc/terms/issued> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/modified
<http://purl.org/dc/terms/modified> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/publisher
<http://purl.org/dc/terms/publisher> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
<http://purl.org/dc/terms/title> rdf:type owl:AnnotationProperty .


###  http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled
<http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#note
<http://www.w3.org/2004/02/skos/core#note> rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/cggallardo/ontologies/2025/3/TourismOntology#hasDate
:hasDate rdf:type owl:ObjectProperty ;
         rdfs:domain [ rdf:type owl:Restriction ;
                       owl:onProperty :hasDate ;
                       owl:someValuesFrom <http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Event>
                     ] .


###  http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#hasBeach
<http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#hasBeach> rdf:type owl:ObjectProperty ,
                                                                                                owl:SymmetricProperty ;
                                                                                       rdfs:domain <http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#City> ;
                                                                                       rdfs:range <http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Beach> ;
                                                                                       rdfs:comment "Relates a coastal city to a beach attraction it possesses. It is a symmetric relation." ;
                                                                                       rdfs:label "hasBeach" .


###  http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#locatedInCity
<http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#locatedInCity> rdf:type owl:ObjectProperty ;
                                                                                            rdfs:domain <http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Attraction> ,
                                                                                                        <http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Hotel> ,
                                                                                                        <http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Restaurant> ,
                                                                                                        <http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Transport> ;
                                                                                            rdfs:range <http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#City> ;
                                                                                            rdfs:comment "Relates an entity to the city where it is located" ;
                                                                                            rdfs:label "located in city" .


###  http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#organizedInCity
<http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#organizedInCity> rdf:type owl:ObjectProperty ;
                                                                                              rdfs:domain <http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Event> ;
                                                                                              rdfs:range <http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#City> ;
                                                                                              rdfs:comment "Relates an event to the city where it is organized." ;
                                                                                              rdfs:label "organized in city" .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#HasLongiutd
<http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#HasLongiutd> rdf:type owl:DatatypeProperty ;
                                                                                          rdfs:domain <http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#City> ;
                                                                                          rdfs:range xsd:string ;
                                                                                          rdfs:comment "Represents the geographic longitude coordinate of a city." ;
                                                                                          rdfs:label "hasLongitude" .


###  http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#hasAverageCost
<http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#hasAverageCost> rdf:type owl:DatatypeProperty ;
                                                                                             rdfs:domain <http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Hotel> ,
                                                                                                         <http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Restaurant> ;
                                                                                             rdfs:range xsd:int ;
                                                                                             rdfs:comment "Indicates the price of the night at the hotel and restaurant" ;
                                                                                             rdfs:label "hasCost" .


###  http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#hasBussines
<http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#hasBussines> rdf:type owl:DatatypeProperty ;
                                                                                          rdfs:domain <http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Transport> ;
                                                                                          rdfs:range xsd:string ;
                                                                                          rdfs:comment "Specifies the company or organization operating the transport service." ;
                                                                                          rdfs:label "hasBusiness" .


###  http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#hasDate
<http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#hasDate> rdf:type owl:DatatypeProperty ;
                                                                                      rdfs:domain <http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Event> ;
                                                                                      rdfs:range xsd:date ;
                                                                                      rdfs:comment "Provides the date on which an event takes place." ,
                                                                                                   "hasDate" .


###  http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#hasLatitud
<http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#hasLatitud> rdf:type owl:DatatypeProperty ;
                                                                                         rdfs:domain <http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#City> ;
                                                                                         rdfs:range xsd:string ;
                                                                                         rdfs:comment "Represents the geographic latitude coordinate of a city." ,
                                                                                                      "hasLatitude" .


###  http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#hasName
<http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#hasName> rdf:type owl:DatatypeProperty ;
                                                                                      rdfs:domain <http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Attraction> ,
                                                                                                  <http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#City> ,
                                                                                                  <http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Event> ,
                                                                                                  <http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Hotel> ,
                                                                                                  <http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Restaurant> ;
                                                                                      rdfs:range xsd:string ;
                                                                                      rdfs:comment "Specifies the name of the entity, such as a hotel, restaurant, or city." ;
                                                                                      rdfs:label "hasName" .


###  http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#hasPricePerNight
<http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#hasPricePerNight> rdf:type owl:DatatypeProperty ;
                                                                                               rdfs:domain <http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Transport> ;
                                                                                               rdfs:range xsd:decimal ;
                                                                                               rdfs:comment "indicates the average price of transport" ;
                                                                                               rdfs:label "hasAverageCost" .


###  http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#hasRating
<http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#hasRating> rdf:type owl:DatatypeProperty ;
                                                                                        rdfs:domain <http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Attraction> ,
                                                                                                    <http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Hotel> ,
                                                                                                    <http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Restaurant> ;
                                                                                        rdfs:range xsd:decimal ;
                                                                                        rdfs:comment "Represents the user rating or evaluation score of an entity" ;
                                                                                        rdfs:label "hasRating" .


###  http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#hasStars
<http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#hasStars> rdf:type owl:DatatypeProperty ;
                                                                                       rdfs:domain <http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Hotel> ;
                                                                                       rdfs:range xsd:integer ;
                                                                                       rdfs:comment "Indicates the number of stars assigned to a hotel as a quality indicator." ;
                                                                                       rdfs:label "hasStars" .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#AndalusianRestaurant
<http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#AndalusianRestaurant> rdf:type owl:Class ;
                                                                                                   rdfs:subClassOf <http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Restaurant> ;
                                                                                                   rdfs:comment "A restaurant specialized in Andalusian cuisine." ;
                                                                                                   rdfs:label "AndalusianRestaurant" .


###  http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Attraction
<http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Attraction> rdf:type owl:Class ;
                                                                                         owl:equivalentClass [ rdf:type owl:Restriction ;
                                                                                                               owl:onProperty <http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#locatedInCity> ;
                                                                                                               owl:someValuesFrom <http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#City>
                                                                                                             ] ;
                                                                                         rdfs:comment "A place that draws visitors due to its interest or significance." ;
                                                                                         rdfs:label "Attraction" .


###  http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Bad
<http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Bad> rdf:type owl:Class ;
                                                                                  rdfs:subClassOf <http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#assessment> ;
                                                                                  rdfs:comment "A negative assessment indicating a poor or unsatisfactory experience." ;
                                                                                  rdfs:label "Bad" .


###  http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Beach
<http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Beach> rdf:type owl:Class ;
                                                                                    rdfs:subClassOf <http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Attraction> ;
                                                                                    rdfs:comment "A pebbly or sandy shore by a body of water." ;
                                                                                    rdfs:isDefinedBy <http://dbpedia.org/resource/Beach> ;
                                                                                    rdfs:label "Beach" .


###  http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#BeachHotel
<http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#BeachHotel> rdf:type owl:Class ;
                                                                                         rdfs:subClassOf <http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Hotel> ;
                                                                                         rdfs:comment "A hotel located near a beach." ;
                                                                                         rdfs:label "Beach Hotel" .


###  http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#BudgetHotel
<http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#BudgetHotel> rdf:type owl:Class ;
                                                                                          rdfs:subClassOf <http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Hotel> ;
                                                                                          rdfs:comment "A hotel designed primarily for business travelers" ;
                                                                                          rdfs:label "BusinessHotel" .


###  http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Bus
<http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Bus> rdf:type owl:Class ;
                                                                                  rdfs:subClassOf <http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Transport> ;
                                                                                  rdfs:comment "Bicycles available for public rental through a bike-sharing system." ;
                                                                                  rdfs:isDefinedBy <http://dbpedia.org/resource/Bus> ;
                                                                                  rdfs:label "Bus" .


###  http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#CapitalCity
<http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#CapitalCity> rdf:type owl:Class ;
                                                                                          rdfs:subClassOf <http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#City> ;
                                                                                          rdfs:comment "A city that functions as the seat of government of a country or region." ;
                                                                                          rdfs:label "CapitalCity" .


###  http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Cheap
<http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Cheap> rdf:type owl:Class ;
                                                                                    rdfs:subClassOf <http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#assessment> ;
                                                                                    rdfs:comment "An assessment indicating that a product or service is low in price or affordable." ;
                                                                                    rdfs:label "Cheap" .


###  http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#City
<http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#City> rdf:type owl:Class ;
                                                                                   rdfs:comment <http://dbpedia.org/resource/City> ,
                                                                                                "A large and permanent human settlement, usually with significant infrastructure and services." ;
                                                                                   rdfs:label "City" .


###  http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#CoastalCity
<http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#CoastalCity> rdf:type owl:Class ;
                                                                                          rdfs:subClassOf <http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#City> ;
                                                                                          rdfs:comment "A city located near or along the coastline." ;
                                                                                          rdfs:label "CoastalCity" .


###  http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#CulturalAtraction
<http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#CulturalAtraction> rdf:type owl:Class ;
                                                                                                rdfs:subClassOf <http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Attraction> ;
                                                                                                rdfs:comment "An attraction significant for its cultural value." ;
                                                                                                rdfs:label "CulturalAttraction" .


###  http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#CulturalEvent
<http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#CulturalEvent> rdf:type owl:Class ;
                                                                                            rdfs:subClassOf <http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Event> ;
                                                                                            rdfs:comment "An event celebrating arts, heritage, or culture." ;
                                                                                            rdfs:label "CulturalEvent" .


###  http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Event
<http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Event> rdf:type owl:Class ;
                                                                                    owl:equivalentClass [ rdf:type owl:Restriction ;
                                                                                                          owl:onProperty :hasDate ;
                                                                                                          owl:someValuesFrom <http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Event>
                                                                                                        ] ;
                                                                                    rdfs:comment "An organized occasion such as a festival, concert, or exhibition." ;
                                                                                    rdfs:label "Event" .


###  http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Expensive
<http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Expensive> rdf:type owl:Class ;
                                                                                        rdfs:subClassOf <http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#assessment> ;
                                                                                        rdfs:comment "An assessment indicating that a product or service is high in price or costly." ;
                                                                                        rdfs:label "Expensive" .


###  http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#GastronomyEvent
<http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#GastronomyEvent> rdf:type owl:Class ;
                                                                                              rdfs:subClassOf <http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Event> ;
                                                                                              rdfs:comment "An event that celebrates food, culinary arts, and gastronomy, often featuring tastings, chefs, or regional cuisine." ;
                                                                                              rdfs:label "GastronomyEvent" .


###  http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Good
<http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Good> rdf:type owl:Class ;
                                                                                   rdfs:subClassOf <http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#assessment> ;
                                                                                   rdfs:comment "A positive assessment indicating a generally satisfactory or high-quality experience." ;
                                                                                   rdfs:label "Good" .


###  http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Hotel
<http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Hotel> rdf:type owl:Class ;
                                                                                    rdfs:comment "An establishment that provides lodging and meals to travelers." ;
                                                                                    rdfs:label "Hotel" .


###  http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#ItalianRestaurant
<http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#ItalianRestaurant> rdf:type owl:Class ;
                                                                                                rdfs:subClassOf <http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Restaurant> ;
                                                                                                rdfs:comment "A restaurant specialized in Italian cuisine." ;
                                                                                                rdfs:label "ItalianRestaurant" .


###  http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#JapaneseRestaurant
<http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#JapaneseRestaurant> rdf:type owl:Class ;
                                                                                                 rdfs:subClassOf <http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Restaurant> ;
                                                                                                 rdfs:comment "A restaurant specialized in Japanese cuisine." ;
                                                                                                 rdfs:isDefinedBy <http://dbpedia.org/resource/Japanese_cuisine> ;
                                                                                                 rdfs:label "JapaneseRestaurant" .


###  http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#LuxuryHotel
<http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#LuxuryHotel> rdf:type owl:Class ;
                                                                                          rdfs:subClassOf <http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Hotel> ;
                                                                                          rdfs:comment "A hotel offering high-end amenities and services." ;
                                                                                          rdfs:label "Luxury Hotel" .


###  http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#MediaterraneanRestaurant
<http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#MediaterraneanRestaurant> rdf:type owl:Class ;
                                                                                                       rdfs:subClassOf <http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Restaurant> ;
                                                                                                       rdfs:comment "A restaurant specialized in Mediterranean cuisine." ;
                                                                                                       rdfs:isDefinedBy <http://dbpedia.org/resource/Mediterranean_cuisine> ;
                                                                                                       rdfs:label "MediterraneanRestaurant" .


###  http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Metro
<http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Metro> rdf:type owl:Class ;
                                                                                    rdfs:subClassOf <http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Transport> ;
                                                                                    rdfs:comment "An underground railway system." ;
                                                                                    rdfs:label "Metro" .


###  http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#MexicanRestaurant
<http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#MexicanRestaurant> rdf:type owl:Class ;
                                                                                                rdfs:subClassOf <http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Restaurant> ;
                                                                                                rdfs:comment "A restaurant specialized in Mexican cuisine." ;
