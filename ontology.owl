            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#hasStars"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
