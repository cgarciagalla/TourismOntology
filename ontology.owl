<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/cggallardo/ontologies/2025/3/TourismOntology#"
     xml:base="http://www.semanticweb.org/cggallardo/ontologies/2025/3/TourismOntology"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrla="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:untitled-ontology-2="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/cggallardo/ontologies/2025/3/TourismOntology">
        <terms:description>This ontology models tourism-related information, including cities, attractions, restaurants, hotels, transport systems, and events. It allows semantic representation and reasoning over various entities in the tourism domain. The ontology supports classification of instances, spatial relationships (e.g., location in city), and quality assessments (e.g., ratings, cost levels). It has been developed following the LOT methodology and includes SWRL rules and links to external resources like DBpedia.</terms:description>
        <terms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">20-04-2025</terms:issued>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">30-04-2025</terms:modified>
        <terms:publisher>Carlos García Gallardo</terms:publisher>
        <terms:title>Tourism Ontology</terms:title>
        <owl:versionInfo>v1.0.0.0</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/terms/description -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/issued -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/issued"/>
    


    <!-- http://purl.org/dc/terms/modified -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/modified"/>
    


    <!-- http://purl.org/dc/terms/publisher -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/publisher"/>
    


    <!-- http://purl.org/dc/terms/title -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled -->


    <owl:AnnotationProperty rdf:about="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#note -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#note"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2001/XMLSchema#date -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.semanticweb.org/cggallardo/ontologies/2025/3/TourismOntology#hasDate -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/cggallardo/ontologies/2025/3/TourismOntology#hasDate">
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/cggallardo/ontologies/2025/3/TourismOntology#hasDate"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Event"/>
            </owl:Restriction>
        </rdfs:domain>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#hasBeach -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#hasBeach">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#City"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Beach"/>
        <rdfs:comment>Relates a coastal city to a beach attraction it possesses. It is a symmetric relation.</rdfs:comment>
        <rdfs:label>hasBeach</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#locatedInCity -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#locatedInCity">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Attraction"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Hotel"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Restaurant"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Transport"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#City"/>
        <rdfs:comment>Relates an entity to the city where it is located</rdfs:comment>
        <rdfs:label>located in city</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#organizedInCity -->


    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#organizedInCity">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Event"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#City"/>
        <rdfs:comment>Relates an event to the city where it is organized.</rdfs:comment>
        <rdfs:label>organized in city</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#HasLongiutd -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#HasLongiutd">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#City"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Represents the geographic longitude coordinate of a city.</rdfs:comment>
        <rdfs:label>hasLongitude</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#hasAverageCost -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#hasAverageCost">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Hotel"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Restaurant"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:comment>Indicates the price of the night at the hotel and restaurant</rdfs:comment>
        <rdfs:label>hasCost</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#hasBussines -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#hasBussines">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Transport"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Specifies the company or organization operating the transport service.</rdfs:comment>
        <rdfs:label>hasBusiness</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#hasDate -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#hasDate">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Event"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment>Provides the date on which an event takes place.</rdfs:comment>
        <rdfs:comment>hasDate</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#hasLatitud -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#hasLatitud">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#City"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Represents the geographic latitude coordinate of a city.</rdfs:comment>
        <rdfs:comment>hasLatitude</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#hasName -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#hasName">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Attraction"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#City"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Event"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Hotel"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Restaurant"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Specifies the name of the entity, such as a hotel, restaurant, or city.</rdfs:comment>
        <rdfs:label>hasName</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#hasPricePerNight -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#hasPricePerNight">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Transport"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>indicates the average price of transport</rdfs:comment>
        <rdfs:label>hasAverageCost</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#hasRating -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#hasRating">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Attraction"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Hotel"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Restaurant"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment>Represents the user rating or evaluation score of an entity</rdfs:comment>
        <rdfs:label>hasRating</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#hasStars -->


    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#hasStars">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Hotel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>Indicates the number of stars assigned to a hotel as a quality indicator.</rdfs:comment>
        <rdfs:label>hasStars</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#AndalusianRestaurant -->


    <owl:Class rdf:about="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#AndalusianRestaurant">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Restaurant"/>
        <rdfs:comment>A restaurant specialized in Andalusian cuisine.</rdfs:comment>
        <rdfs:label>AndalusianRestaurant</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Attraction -->


    <owl:Class rdf:about="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Attraction">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#locatedInCity"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#City"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:comment>A place that draws visitors due to its interest or significance.</rdfs:comment>
        <rdfs:label>Attraction</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Bad -->


    <owl:Class rdf:about="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Bad">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#assessment"/>
        <rdfs:comment>A negative assessment indicating a poor or unsatisfactory experience.</rdfs:comment>
        <rdfs:label>Bad</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Beach -->


    <owl:Class rdf:about="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Beach">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Attraction"/>
        <rdfs:comment>A pebbly or sandy shore by a body of water.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://dbpedia.org/resource/Beach"/>
        <rdfs:label>Beach</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#BeachHotel -->


    <owl:Class rdf:about="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#BeachHotel">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Hotel"/>
        <rdfs:comment>A hotel located near a beach.</rdfs:comment>
        <rdfs:label>Beach Hotel</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#BudgetHotel -->


    <owl:Class rdf:about="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#BudgetHotel">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Hotel"/>
        <rdfs:comment>A hotel designed primarily for business travelers</rdfs:comment>
        <rdfs:label>BusinessHotel</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Bus -->


    <owl:Class rdf:about="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Bus">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Transport"/>
        <rdfs:comment>Bicycles available for public rental through a bike-sharing system.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://dbpedia.org/resource/Bus"/>
        <rdfs:label>Bus</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#CapitalCity -->


    <owl:Class rdf:about="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#CapitalCity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#City"/>
        <rdfs:comment>A city that functions as the seat of government of a country or region.</rdfs:comment>
        <rdfs:label>CapitalCity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Cheap -->


    <owl:Class rdf:about="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Cheap">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#assessment"/>
        <rdfs:comment>An assessment indicating that a product or service is low in price or affordable.</rdfs:comment>
        <rdfs:label>Cheap</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#City -->


    <owl:Class rdf:about="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#City">
        <rdfs:comment rdf:resource="http://dbpedia.org/resource/City"/>
        <rdfs:comment>A large and permanent human settlement, usually with significant infrastructure and services.</rdfs:comment>
        <rdfs:label>City</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#CoastalCity -->


    <owl:Class rdf:about="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#CoastalCity">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#City"/>
        <rdfs:comment>A city located near or along the coastline.</rdfs:comment>
        <rdfs:label>CoastalCity</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#CulturalAtraction -->


    <owl:Class rdf:about="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#CulturalAtraction">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Attraction"/>
        <rdfs:comment>An attraction significant for its cultural value.</rdfs:comment>
        <rdfs:label>CulturalAttraction</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#CulturalEvent -->


    <owl:Class rdf:about="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#CulturalEvent">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Event"/>
        <rdfs:comment>An event celebrating arts, heritage, or culture.</rdfs:comment>
        <rdfs:label>CulturalEvent</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Event -->


    <owl:Class rdf:about="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Event">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/cggallardo/ontologies/2025/3/TourismOntology#hasDate"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Event"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:comment>An organized occasion such as a festival, concert, or exhibition.</rdfs:comment>
        <rdfs:label>Event</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Expensive -->


    <owl:Class rdf:about="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Expensive">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#assessment"/>
        <rdfs:comment>An assessment indicating that a product or service is high in price or costly.</rdfs:comment>
        <rdfs:label>Expensive</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#GastronomyEvent -->


    <owl:Class rdf:about="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#GastronomyEvent">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Event"/>
        <rdfs:comment>An event that celebrates food, culinary arts, and gastronomy, often featuring tastings, chefs, or regional cuisine.</rdfs:comment>
        <rdfs:label>GastronomyEvent</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Good -->


    <owl:Class rdf:about="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Good">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#assessment"/>
        <rdfs:comment>A positive assessment indicating a generally satisfactory or high-quality experience.</rdfs:comment>
        <rdfs:label>Good</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Hotel -->


    <owl:Class rdf:about="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Hotel">
