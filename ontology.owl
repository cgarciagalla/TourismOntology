        <owl:disjointUnionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Bus"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Metro"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#PublicBike"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Taxi"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/cggallardo/ontologies/2025/3/untitled-ontology-2#Tram"/>
        </owl:disjointUnionOf>
        <rdfs:comment>rdfs:comment:&quot;An establishment where meals are prepared and served to customers.</rdfs:comment>
        <rdfs:label>Transport</rdfs:label>
    </owl:Class>
    


